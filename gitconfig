[core]
	excludesfile = ~/.gitignore
	hooksPath = /Users/sajjad/.config/git/hooks
[commit]
	template = ~/.gitmessage
[diff]
	algorithm = histogram
[fetch]
	prune = true
[user]
	useConfigOnly = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[include]
	path = /Users/sajjad/.gitconfig.work
[includeIf "gitdir:/Users/sajjad/work/others/"]
	path = /Users/sajjad/.gitconfig.personal
